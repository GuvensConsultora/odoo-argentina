<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Por qué: Reemplaza el QR de pago nativo de Odoo por el QR fiscal de AFIP (CAE).
         Patrón: position="replace" sobre div[@id='qrcode'] sustituye el bloque completo.
         Tip: En v19 el div está condicionado por t-else (show_qr), pero el xpath
              lo resuelve estáticamente sobre el arch, no sobre el render. -->
    <template id="qr_report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='qrcode']" position="replace">
            <div id="qrcode" class="d-flex mb-3 avoid-page-break-inside"
                 style="border: 1px solid #dee2e6; border-radius: 4px; padding: 8px;"
                 t-if="o.afip_cae">
                <div class="me-3" style="min-width: 200px;">
                    <p class="mb-1"><strong>CAE: </strong><span t-field="o.afip_cae"/></p>
                    <p class="mb-0"><strong>Vto. CAE: </strong><span t-field="o.afip_cae_due"/></p>
                </div>
                <div t-if="o.qr_code" class="ms-auto">
                    <img class="border border-dark rounded"
                         height="120" width="120"
                         t-att-src="image_data_uri(o.qr_code)"/>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
