<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ============================================================
     Template: Certificado de Retención (Ganancias / IVA)
     Por qué: reescritura completa del certificado con diseño
     profesional A4, secciones condicionales por tipo de impuesto,
     y fix de campos rotos (reconciled_invoice_ids, _get_invoice_payment_amount)
     ============================================================ -->

<template id="report_payment_withholding_document">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <div class="page" style="font-family: Arial, sans-serif; font-size: 10px;">

            <!-- ========== ENCABEZADO ========== -->
            <div style="text-align: center; margin-bottom: 12px; border-bottom: 3px solid #2c3e50; padding-bottom: 10px;">
                <h3 style="font-size: 16px; font-weight: bold; margin: 0; color: #2c3e50;">
                    CERTIFICADO DE RETENCIÓN
                </h3>
                <p style="font-size: 13px; margin: 4px 0 0 0; color: #2c3e50; font-weight: bold;">
                    <t t-esc="o.get_withholding_type_label()"/>
                </p>
                <p t-if="o.get_withholding_norma()" style="font-size: 10px; margin: 2px 0 0 0; color: #555;">
                    <t t-esc="o.get_withholding_norma()"/>
                </p>
                <div class="row" style="margin-top: 8px;">
                    <div class="col-6 text-left" style="font-size: 10px;">
                        <strong>Nro. Certificado:</strong> <span t-field="o.withholding_number"/>
                    </div>
                    <div class="col-6 text-right" style="font-size: 10px;">
                        <strong>Fecha:</strong> <span t-field="o.date" t-options="{'widget': 'date'}"/>
                    </div>
                </div>
            </div>

            <!-- ========== AGENTE DE RETENCIÓN (empresa) ========== -->
            <div style="margin-bottom: 10px;">
                <div style="background-color: #2c3e50; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px;">
                    AGENTE DE RETENCIÓN
                </div>
                <table style="width: 100%; border: 1px solid #ccc; border-top: none; border-collapse: collapse;">
                    <tr>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee; width: 50%;">
                            <strong>Razón Social:</strong> <span t-field="o.company_id.name"/>
                        </td>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee; width: 50%;">
                            <strong>CUIT:</strong> <span t-field="o.company_id.vat"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;">
                            <strong>Condición IVA:</strong>
                            <span t-field="o.company_id.partner_id.l10n_ar_afip_responsibility_type_id.name"/>
                        </td>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;">
                            <strong>Domicilio:</strong>
                            <span t-field="o.company_id.partner_id.street"/>
                            <t t-if="o.company_id.partner_id.city">
                                - <span t-field="o.company_id.partner_id.city"/>
                            </t>
                            <t t-if="o.company_id.partner_id.state_id">
                                - <span t-field="o.company_id.partner_id.state_id.name"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 4px 8px;">
                            <strong>Ingresos Brutos:</strong>
                            <t t-if="o.company_id.l10n_ar_gross_income_type == 'exempt'">
                                No liquida
                            </t>
                            <span t-if="o.company_id.l10n_ar_gross_income_type != 'exempt'"
                                  t-field="o.company_id.l10n_ar_gross_income_number"/>
                        </td>
                        <td style="padding: 4px 8px;">
                            <strong>Inicio de Actividades:</strong>
                            <span t-field="o.company_id.l10n_ar_afip_start_date" t-options="{'widget': 'date'}"/>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- ========== SUJETO RETENIDO (partner) ========== -->
            <div style="margin-bottom: 10px;">
                <div style="background-color: #2c3e50; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px;">
                    SUJETO RETENIDO
                </div>
                <table style="width: 100%; border: 1px solid #ccc; border-top: none; border-collapse: collapse;">
                    <tr>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee; width: 50%;">
                            <strong>Razón Social:</strong> <span t-field="o.partner_id.commercial_partner_id.name"/>
                        </td>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee; width: 50%;">
                            <strong>CUIT:</strong> <span t-field="o.partner_id.commercial_partner_id.vat"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;">
                            <strong>Condición IVA:</strong>
                            <span t-field="o.partner_id.commercial_partner_id.l10n_ar_afip_responsibility_type_id.name"/>
                        </td>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;">
                            <strong>Domicilio:</strong>
                            <span t-field="o.partner_id.commercial_partner_id.street"/>
                            <t t-if="o.partner_id.commercial_partner_id.city">
                                - <span t-field="o.partner_id.commercial_partner_id.city"/>
                            </t>
                            <t t-if="o.partner_id.commercial_partner_id.state_id">
                                - <span t-field="o.partner_id.commercial_partner_id.state_id.name"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 4px 8px;" colspan="1">
                            <strong>Ingresos Brutos:</strong>
                            <span t-if="o.partner_id.commercial_partner_id.gross_income_number"
                                  t-field="o.partner_id.commercial_partner_id.gross_income_number"/>
                            <span t-if="not o.partner_id.commercial_partner_id.gross_income_number">-</span>
                        </td>
                        <!-- Solo Ganancias: condición del sujeto -->
                        <td t-if="o.is_ganancias_withholding()" style="padding: 4px 8px;">
                            <strong>Cond. Ganancias:</strong>
                            <span t-esc="o.get_ganancias_condition_label()"/>
                        </td>
                        <td t-if="not o.is_ganancias_withholding()" style="padding: 4px 8px;"/>
                    </tr>
                </table>
            </div>

            <!-- ========== DATOS DE LA RETENCIÓN ========== -->
            <div style="margin-bottom: 10px;">
                <div style="background-color: #2c3e50; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px;">
                    DATOS DE LA RETENCIÓN
                </div>
                <table style="width: 100%; border: 1px solid #ccc; border-top: none; border-collapse: collapse;">
                    <tr>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee; width: 50%;">
                            <strong>Impuesto:</strong>
                            <t t-esc="o.get_withholding_type_label()"/>
                        </td>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee; width: 50%;">
                            <strong>Norma aplicable:</strong>
                            <t t-esc="o.get_withholding_norma()"/>
                        </td>
                    </tr>
                    <!-- Solo Ganancias: régimen -->
                    <tr t-if="o.is_ganancias_withholding()">
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;" colspan="2">
                            <strong>Régimen:</strong>
                            <t t-esc="o.get_regimen_ganancias_label()"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;">
                            <strong>Fecha de Retención:</strong>
                            <span t-field="o.date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td style="padding: 4px 8px; border-bottom: 1px solid #eee;">
                            <strong>Retención:</strong>
                            <span t-field="o.tax_withholding_id.display_name"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 4px 8px;" colspan="2">
                            <strong>Nro. Comprobante de Pago:</strong>
                            <span t-if="o.payment_group_id" t-field="o.payment_group_id.display_name"/>
                            <span t-if="not o.payment_group_id">-</span>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- ========== LIQUIDACIÓN ========== -->
            <div style="margin-bottom: 10px;">
                <div style="background-color: #2c3e50; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px;">
                    LIQUIDACIÓN
                </div>
                <table style="width: 100%; border: 1px solid #ccc; border-top: none; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f5f5f5;">
                            <th style="padding: 4px 8px; border: 1px solid #ccc; text-align: right; width: 33%;">
                                Base Imponible
                            </th>
                            <th style="padding: 4px 8px; border: 1px solid #ccc; text-align: right; width: 33%;">
                                Alícuota (%)
                            </th>
                            <th style="padding: 4px 8px; border: 1px solid #ccc; text-align: right; width: 34%;">
                                Importe Retenido
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 6px 8px; border: 1px solid #ccc; text-align: right; font-size: 11px;">
                                <span t-field="o.withholdable_base_amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td style="padding: 6px 8px; border: 1px solid #ccc; text-align: right; font-size: 11px;">
                                <t t-esc="'%.2f' % o.get_withholding_alicuota()"/> %
                            </td>
                            <td style="padding: 6px 8px; border: 1px solid #ccc; text-align: right; font-size: 11px; font-weight: bold;">
                                <span t-field="o.amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- ========== COMPROBANTES QUE ORIGINAN LA RETENCIÓN ========== -->
            <t t-set="invoices" t-value="o.get_withholding_invoices()"/>
            <div t-if="invoices" style="margin-bottom: 10px;">
                <div style="background-color: #2c3e50; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px;">
                    COMPROBANTES QUE ORIGINAN LA RETENCIÓN
                </div>
                <table style="width: 100%; border: 1px solid #ccc; border-top: none; border-collapse: collapse; font-size: 9px;">
                    <thead>
                        <tr style="background-color: #f5f5f5;">
                            <th style="padding: 3px 6px; border: 1px solid #ccc;">Fecha</th>
                            <th style="padding: 3px 6px; border: 1px solid #ccc;">Comprobante</th>
                            <th style="padding: 3px 6px; border: 1px solid #ccc;">Referencia</th>
                            <th style="padding: 3px 6px; border: 1px solid #ccc; text-align: right;">Importe</th>
                            <th style="padding: 3px 6px; border: 1px solid #ccc; text-align: right;">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="invoices" t-as="inv">
                            <td style="padding: 3px 6px; border: 1px solid #ccc;">
                                <span t-field="inv.invoice_date"/>
                            </td>
                            <td style="padding: 3px 6px; border: 1px solid #ccc;">
                                <span t-field="inv.name"/>
                            </td>
                            <td style="padding: 3px 6px; border: 1px solid #ccc;">
                                <span t-field="inv.ref"/>
                            </td>
                            <td style="padding: 3px 6px; border: 1px solid #ccc; text-align: right;">
                                <span t-field="inv.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                            </td>
                            <td style="padding: 3px 6px; border: 1px solid #ccc; text-align: right;">
                                <span t-field="inv.amount_residual"
                                      t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- ========== OBSERVACIONES ========== -->
            <div t-if="o.communication" style="margin-bottom: 10px;">
                <div style="background-color: #2c3e50; color: white; padding: 4px 8px; font-weight: bold; font-size: 10px;">
                    OBSERVACIONES
                </div>
                <div style="border: 1px solid #ccc; border-top: none; padding: 6px 8px; font-size: 10px;">
                    <span t-field="o.communication"/>
                </div>
            </div>

            <!-- ========== FIRMA Y SELLO ========== -->
            <div style="margin-top: 40px; text-align: center;">
                <div style="display: inline-block; width: 220px; border-top: 1px solid #333; padding-top: 4px; font-size: 9px;">
                    Firma y Sello del Agente de Retención
                </div>
            </div>

            <!-- ========== PIE ========== -->
            <div style="margin-top: 20px; border-top: 1px solid #ccc; padding-top: 6px; font-size: 8px; color: #888;">
                <div class="row">
                    <div class="col-6">
                        <strong>Original:</strong> Sujeto Retenido
                    </div>
                    <div class="col-6 text-right">
                        <strong>Duplicado:</strong> Agente de Retención
                    </div>
                </div>
                <p t-if="o.is_ganancias_withholding()" style="margin-top: 4px; text-align: center;">
                    Este certificado se emite en cumplimiento de la RG 830/2000 AFIP,
                    Anexo II y concordantes. El agente de retención es responsable
                    de su ingreso ante la AFIP.
                </p>
                <p t-if="not o.is_ganancias_withholding() and o.get_withholding_norma()" style="margin-top: 4px; text-align: center;">
                    Este certificado se emite en cumplimiento de la
                    <t t-esc="o.get_withholding_norma()"/>.
                    El agente de retención es responsable de su ingreso ante la AFIP.
                </p>
            </div>

        </div>
    </t>
</template>

<!-- Wrapper: itera docs -->
<template id="report_payment_withholding">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="l10n_ar_report_withholding.report_payment_withholding_document"
               t-lang="o.partner_id.lang"/>
        </t>
    </t>
</template>

<!-- Acción de reporte QWeb-PDF -->
<record id="action_payment_withholdings" model="ir.actions.report">
    <field name="name">Certificado de Retención</field>
    <field name="model">account.payment</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_ar_report_withholding.report_payment_withholding</field>
    <field name="report_file">l10n_ar_report_withholding.report_payment_withholding</field>
    <field name="print_report_name">'Retención - %s' % object.withholding_number</field>
    <field name="binding_model_id" ref="account.model_account_payment"/>
    <field name="binding_type">report</field>
</record>

</data>
</odoo>
