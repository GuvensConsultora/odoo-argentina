<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name='ref' position="after">
                <div colspan="2">
                    <!--
                        El bloque se muestra con los códigos que este módulo crea en
                        data/account_payment_method_data.xml. La condición histórica
                        preguntaba por 'withholding' a secas, que no existe: el bloque
                        quedaba oculto siempre.

                        El dominio del impuesto lee l10n_ar_withholding_payment_type,
                        que es la marca de la localización de Odoo. Se prefiere a
                        type_tax_use porque las dos marcas son excluyentes entre sí
                        (l10n_ar_withholding borra la suya cuando type_tax_use != 'none'):
                        leyendo la de Odoo, el mismo impuesto sirve para este circuito
                        y para el asistente nativo de registro de pagos.
                    -->
                    <group string="Datos de la retención" name="withholding_data"
                           invisible="payment_method_code not in ('withholding', 'withholding_customers', 'withholding_suppliers')">
                        <field name="tax_withholding_id" options="{'no_create': True, 'no_open': True}"
                               string="Impuesto de retención"
                               domain="[('l10n_ar_withholding_payment_type', '=', partner_type), ('company_id', '=', company_id)]"
                               required="payment_method_code in ('withholding', 'withholding_customers', 'withholding_suppliers')"/>
                        <field name="withholding_number" string="Número de retención"/>
                        <field name="withholding_base_amount"
                               required="payment_method_code in ('withholding', 'withholding_customers', 'withholding_suppliers')"
                               string="Monto base de la retención"/>
                    </group>
                </div>
            </field>
            <!--
                La grilla nativa de retenciones (l10n_ar_withholding_ids) queda SIEMPRE
                vacía en este circuito: no escribimos tax_repartition_line_id en la línea,
                porque el _synchronize_to_moves() de l10n_ar_withholding borra las líneas
                que lo tienen. Una grilla vacía con títulos en inglés no informa nada y
                hace dudar al operador de si le falta cargar algo ahí. Se oculta.
            -->
            <xpath expr="//field[@name='l10n_ar_withholding_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                  <notebook>
                          <page string="Notas">
                                  <field name="communication" />
                          </page>
                  </notebook>
             </xpath>
          </field>
    </record>
</odoo>
