<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Por qué: l10n_latam_check_* fields removidos de account.payment en Odoo 19 -->
    <!-- Tip: en Odoo 19 los datos del cheque están en el modelo l10n_latam.check directo -->
    <record id="view_payment_check_tree" model="ir.ui.view">
        <field name="name">account_check.account.payment.tree</field>
        <field name="model">account.payment</field>
	<field name="arch" type="xml">
		<tree>
			<field name="name"/>
			<field name="partner_id"/>
			<field name="date"/>
			<field name="amount"/>
			<field name="currency_id"/>
		</tree>
        </field>
    </record>

    <!-- Odoo 19: l10n_latam_check.view_account_payment_form_inherited y
         l10n_latam_check_id eliminados. Vista deshabilitada hasta adaptar
         al nuevo modelo de cheques de Odoo 19. -->
